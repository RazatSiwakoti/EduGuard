# ─────────────────────────────────────────────────────────────
# EduGuard Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# DO NOT put real passwords in this file (.env.example is public)
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=EduGuard
DEBUG=True
TIMEZONE=Australia/Sydney

# Database
DATABASE_URL=sqlite:///./test.db

# SMTP Email Configuration (Gmail / Office365 / Custom SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=EduGuard Support

# Academic Alert Defaults
ALERT_THRESHOLD=0.7
CHECKPOINT_WEEK=4
